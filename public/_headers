# Servir archivos Markdown como texto plano (Netlify / Cloudflare Pages).
# Por defecto el navegador los descarga; queremos que rendericen y que los
# fetchers de IA los puedan leer sin negociar Content-Type.
/*.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: index, follow

# llms.txt como text/plain explícito (algunos hosts lo entregan como
# application/octet-stream y rompe los fetchers).
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: index, follow

# robots.txt y sitemap.xml — defaults sanos
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
